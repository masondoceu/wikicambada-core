{
  "name": "heartbeat-wiki",
  "version": "1.1.0-r2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node src/scripts/build-public.mjs",
    "predev": "npm run build",
    "predeploy": "npm run build",
    "dev": "node src/scripts/dev.mjs",
    "deploy": "wrangler pages deploy .wikicambada/public --project-name heartbeat-wiki",
    "db:migrations:apply:local": "wrangler d1 migrations apply heartbeat-wiki-d1 --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply heartbeat-wiki-d1 --remote",
    "test": "node src/scripts/test.mjs",
    "typecheck": "tsc --pretty false",
    "setup": "node setup.js",
    "verify": "node setup.js verify"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
